# =============================================================================
# Global Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

# ---- General ----
APP_NAME=FastAPI Nuxt Template App
ENVIRONMENT=development
DEBUG=True

# ---- Database (PostgreSQL) ----
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ---- Redis ----
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_HOST=redis

# ---- Mailpit (Email testing) ----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_HOST=mailpit


# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
BACKEND_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8080
BACKEND_CORS_TRUSTED_HOSTS=localhost,127.0.0.1,testserver,
BACKEND_CORS_CREDENTIALS=True
BACKEND_CORS_ALLOW_METHODS=*
BACKEND_CORS_ALLOW_HEADERS=*
BACKEND_API_PREFIX=/api
BACKEND_DEBUG=True
JWT_ALGORITHM=ES256
JWT_ISSUER=http://localhost:8000
JWT_AUDIENCE=http://localhost:3000
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_DAYS=7
OTP_EXPIRE_SECONDS=30


# ---- Frontend (Nuxt 4) ----
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# ---- Nginx ----
NGINX_PORT=8080
NGINX_HOST=nginx
NGINX_CONFIG=nginx.conf
NGINX_LOGS=nginx_logs
