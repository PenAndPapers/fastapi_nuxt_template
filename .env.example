# =============================================================================
# Global Environment Configuration
# Copy this file to .env and adjust values for your environment
# =============================================================================

# ---- General ----
APP_NAME=FastAPI Nuxt Template App
ENVIRONMENT=development
DEBUG=True

# ---- Database (PostgreSQL) ----
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# ---- Redis ----
REDIS_PASSWORD=redis_password
REDIS_PORT=6379
REDIS_HOST=redis

# ---- Mailpit (Email testing) ----
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_HOST=mailpit


# ---- Backend (FastAPI) ----
BACKEND_PORT=8000
BACKEND_SECRET_KEY=ed8f2ea7573298e6365e4168237a5a82c1365e2e084850adedc51419f572db15
BACKEND_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
BACKEND_API_PREFIX=/api
BACKEND_DEBUG=True
JWT_ALGORITHM=HS256
JWT_SECRET_KEY=ed8f2ea7573298e6365e4168237a5a82c1365e2e084850adedc51419f572db15
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=1440
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=10080
OTP_EXPIRE_SECONDS=30


# ---- Frontend (Nuxt 4) ----
FRONTEND_PORT=3000
API_BASE_URL=http://localhost:8000

# ---- Nginx ----
NGINX_PORT=8080
NGINX_HOST=nginx
NGINX_CONFIG=nginx.conf
NGINX_LOGS=nginx_logs
