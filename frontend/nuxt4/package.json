{
  "name": "nuxt4",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxi typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,json,md,css,scss}\"",
    "test": "pnpm run test:unit",
    "test:unit": "pnpm run test:unit",
    "test:e2e": "pnpm run test:e2e",
    "test:e2e:docker": "docker compose exec frontend pnpm run test:e2e"
  },
  "dependencies": {
    "@pinia/nuxt": "^1.0.2",
    "axios": "^1.8.1",
    "nuxt": "^4.5.2",
    "pinia": "^4.0.3",
    "primevue": "^5.0.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@primevue/nuxt-module": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "tailwindcss": "^4.3.3",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.0.1",
    "prettier": "^3.4.2",
    "typescript": "^7.0.2",
    "vue-tsc": "^3.3.11"
  }
}
